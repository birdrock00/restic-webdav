# restic image with WebDAV support.
#
# restic reaches WebDAV servers through its built-in `rclone` backend, which
# needs the rclone binary at runtime; the official restic image does not ship
# it. This image is the official restic image plus the rclone binary, so the
# restic side is always exactly the upstream build.
#
# Build args:
#   RESTIC_TAG   tag of the upstream restic image (default: latest)
#   RCLONE_IMAGE rclone image to take the binary from (default: rclone/rclone:latest)

ARG RESTIC_TAG=latest
ARG RCLONE_IMAGE=docker.io/rclone/rclone:latest

FROM ${RCLONE_IMAGE} AS rclone

FROM ghcr.io/restic/restic:${RESTIC_TAG}

COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone

ENTRYPOINT ["/usr/bin/restic"]
